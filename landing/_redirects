# Deep link rewrites — serve open.html at the original URL so the page
# can read window.location.pathname and reconstruct the divera:// scheme.
# Target the clean "/open" (NOT "/open.html"): the .html path triggers
# Cloudflare's clean-URL 307 redirect, which discards the original path
# and loses the id. Rewriting to /open keeps /dive/<id> intact.
# iOS intercepts these via Universal Links (AASA) before they reach the web;
# open.html is the fallback for users without the app or on other platforms.
/dive/*          /open  200
/dive-site/*     /open  200
/dive-center/*   /open  200
/profile/*       /open  200
/fish/*          /open  200
/planned-dive/*  /open  200
